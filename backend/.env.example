# ============================================
# SMART RESTAURANT BACKEND - Environment Setup
# ============================================
# Copy file này thành .env và điền thông tin của bạn
# Windows: copy .env.example .env
# Mac/Linux: cp .env.example .env

# ============ DATABASE ============
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/smart_restaurant

# ============ SERVER ============
PORT=4000
NODE_ENV=development

# ============ JWT AUTHENTICATION ============
# BẮT BUỘC — tối thiểu 32 ký tự, khác QR_JWT_SECRET. Backend từ chối khởi động nếu thiếu/yếu.
# Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ============ QR CODE ============
# BẮT BUỘC — secret riêng để ký QR token (tạo giống JWT_SECRET)
QR_JWT_SECRET=

# URL Frontend - QUAN TRỌNG cho QR code hoạt động trên điện thoại
# Thay YOUR_IP bằng IP máy tính của bạn
# Tìm IP: chạy "ipconfig" (Windows) hoặc "ifconfig" (Mac/Linux)
# Chọn IPv4 dạng 192.168.x.x
CLIENT_BASE_URL=http://YOUR_IP:3000

# ============ EMAIL (Optional) ============
# Dùng để gửi email reset password
# Với Gmail: tạo App Password tại https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ============ GOOGLE OAUTH (Optional) ============
# Tạo tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============ HƯỚNG DẪN TÌM IP ============
# Windows PowerShell: ipconfig | Select-String "IPv4"
# Windows CMD: ipconfig | findstr "IPv4"
# Mac/Linux: ifconfig | grep "inet "
# → Chọn IP dạng 192.168.x.x (cùng mạng WiFi với điện thoại)

# ============ STRIPE PAYMENT (Optional) ============
# Đăng ký tại: https://dashboard.stripe.com
# Sử dụng test mode keys để thử nghiệm
# Đặt STRIPE_SECRET_KEY thì BẮT BUỘC đặt STRIPE_WEBHOOK_SECRET (webhook luôn được xác thực chữ ký)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============ VIETQR BANK TRANSFER ============
# Thông tin tài khoản ngân hàng nhận tiền
# Danh sách mã ngân hàng: https://api.vietqr.io/v2/banks
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=SMART RESTAURANT